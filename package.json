{
  "name": "apptaxas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @apptaxas/api dev",
    "dev:web": "pnpm --filter @apptaxas/web dev",
    "dev:mobile": "pnpm --filter @apptaxas/mobile start",
    "test": "vitest run",
    "test:unit": "vitest run packages/domain apps/api/tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint apps packages infra/migrations --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.json eslint.config.js prettier.config.js vitest.config.ts apps packages infra/migrations docs .github/workflows"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
